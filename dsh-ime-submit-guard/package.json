{
  "name": "dsh-ime-submit-guard",
  "version": "1.0.0",
  "description": "阻止输入法（语音转文字）在合成收尾时把 DSH 聊天消息自动发送出去，并让键盘只在手动点击输入框时唤起",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ime",
    "composition",
    "lexical",
    "deepseek"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
