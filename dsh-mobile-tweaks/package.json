{
  "name": "dsh-mobile-tweaks",
  "version": "1.0.0",
  "description": "Phone-side DSH tweaks for DSH-Folk: sidebar layout (brand row pinned to the bottom, auto-collapse in portrait, status-bar clearance, camera-cutout jump fix) plus composer IME guards (dictation submit guard, focus guard).",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mobile",
    "sidebar",
    "ime",
    "composer",
    "ui",
    "deepseek"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
