{
  "name": "dsh-sidebar-tweaks",
  "version": "1.0.0",
  "description": "DSH 移动端侧边栏重排：插件 / 工作区 / 鲸鱼 / 新建会话 / 设置 的层级与沉底布局，以及状态栏安全区自适应",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "ui",
    "deepseek"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
